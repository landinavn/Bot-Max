# Скопируйте файл в .env и заполните значения.
MAX_BOT_TOKEN=
# Ключ OpenAI API для генерации; не требуется для загрузки фото в MAX.
IMAGE_API_KEY=
# Модель OpenAI Images API; также можно выбрать gpt-image-2.5-flare.
IMAGE_MODEL=openai/gpt-image-1

# Yandex Object Storage: существующий бакет с публичным чтением объектов.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=https://storage.yandexcloud.net
STORAGE_REGION=ru-central1
# Статический ключ доступа сервисного аккаунта с правом записи в бакет.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Необязательно: публичный CDN URL. По умолчанию —
# https://storage.yandexcloud.net/<STORAGE_BUCKET>.
STORAGE_PUBLIC_BASE_URL=

# Платёжная форма Prodamus, например https://your-shop.payform.ru.
# Для включения оплаты заполните все четыре поля PRODAMUS_*.
PRODAMUS_DOMAIN=https://fotobot.payform.ru/
PRODAMUS_SECRET_KEY=06c39c1ab3f1fd0a2a29f3fca4bd1e03ccb913024a8176752da283077a0d5d0e
# Публичная HTTPS-ссылка для возврата покупателя (например, ссылка на MAX-бота).
PRODAMUS_RETURN_URL=https://max.ru/se14596751_1_bot
# Публичный HTTPS endpoint, проксируемый на HTTP-порт бота.
# Например: https://bot.example.ru/prodamus/webhook
PRODAMUS_WEBHOOK_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
