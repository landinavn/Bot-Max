# Скопируйте файл в .env и заполните значения.
MAX_BOT_TOKEN=
# Числовой user_id администратора с бесплатными генерациями; пусто — без исключений.
ADMIN_USER_ID=
# Ключ OpenAI для генерации; не требуется для загрузки фото в MAX.
IMAGE_API_KEY=
OPENAI_PROXY_URL=http://94.249.177.108:8888
# Модель OpenAI Images API.
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=high

# TTAPI (Suno): ключ для генерации аудиопесен.
TTAPI_KEY=

# PiAPI (Kling): ключ для генерации видео.
PIAPI_KEY=

# Yandex Object Storage: существующий бакет с публичным чтением объектов.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=https://storage.yandexcloud.net
STORAGE_REGION=ru-central1
# Статический ключ доступа сервисного аккаунта с правом записи в бакет.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Необязательно: публичный CDN URL. По умолчанию —
# https://storage.yandexcloud.net/<STORAGE_BUCKET>.
STORAGE_PUBLIC_BASE_URL=

# Платёжная форма Prodamus, например https://your-shop.payform.ru.
# Для включения оплаты заполните все четыре поля PRODAMUS_*.
PRODAMUS_DOMAIN=
PRODAMUS_SECRET_KEY=
# Публичная HTTPS-ссылка для возврата покупателя (например, ссылка на MAX-бота).
PRODAMUS_RETURN_URL=
# Публичный HTTPS endpoint, проксируемый на HTTP-порт бота.
# Например: https://bot.example.ru/prodamus/webhook
PRODAMUS_WEBHOOK_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
BOT_LINK=https://max.ru/se14596751_1_bot

# Офлайн-конверсии Яндекс.Метрики (необязательно).
YANDEX_METRIKA_COUNTER_ID=
YANDEX_METRIKA_OAUTH_TOKEN=

# Озвучка только административной мультстудии: Yandex SpeechKit API v1.
# API-ключ сервисного аккаунта с ролью ai.speechkit-tts.user.
YANDEX_TTS_API_KEY=

# Мультстудия: оценка SpeechKit v3 в USD за каждые 250 символов одной реплики.
# Ненулевая цена обязательна перед подтверждением голоса masha.
STUDIO_TTS_V3_250_CHARS_USD=0

# Административное поздравление Деда Мороза (не требует STUDIO_ENABLED).
HEYGEN_API_KEY=
# Озвучка Деда Мороза: подтверждённый Instant-клон HeyGen «Дед мороз», Russian.
DED_MOROZ_HEYGEN_VOICE_ID=3146577ad1e544c1a4658ded1090740c
DED_MOROZ_TTS_MODEL=heygen-voice-1
# Локальная обработка MP3 перед предпрослушиванием и Avatar IV.
DED_MOROZ_SPEECH_SPEED=0.90
DED_MOROZ_ECHO_DELAY_MS=55
DED_MOROZ_ECHO_DECAY=0.10
# Старые настройки ElevenLabs сохранены для независимых интеграций.
ELEVENLABS_API_KEY=
DED_MOROZ_VOICE_ID=
# Необязательно: ID уже готового Photo Avatar Look; иначе будет создан один раз.
DED_MOROZ_AVATAR_ID=
# Необязательно: публичный HTTPS URL референса; иначе examples/ded_moroz_ref.png.
DED_MOROZ_REF_URL=
# Используются существующие STORAGE_*, STUDIO_FILES_DIR.
# Озвучка Деда Мороза: HeyGen Voice, MP3 44100 Hz / 192 kbps.
# HEYGEN_API_KEY используется для озвучки, аватара и видео.
# Для видео нужны examples/audio/jingle_bells.mp3 и examples/audio/ny_music.mp3.
# examples/fire_overlay.mp4 необязателен: без него монтаж пропускает огонь.
