# EXAMPLE ONLY. Do not use a real database or enable SMTP during isolated tests.
WEB_API_ENV=production
WEB_API_ORIGIN=https://app.wish-bot.ru
WEB_API_DATABASE=/var/lib/wish-api/auth.sqlite3
# Supply a separate randomly generated secret (at least 32 bytes), never a bot/payment key.
WEB_API_AUTH_SECRET=
WEB_API_SECURE_COOKIES=true
WEB_API_TRUSTED_PROXIES=127.0.0.1/32,::1/128
WEB_API_DEV_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Proposed sender. This mailbox/domain is not yet provisioned or verified.
SMTP_FROM_EMAIL=noreply@wish-bot.ru
SMTP_FROM_NAME=Нейрофото
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=5
