# Template only. Linking is disabled; do not enable on production without a separate review.
MAX_ACCOUNT_LINKING_ENABLED=false
WEB_MAX_LINKING_ENABLED=false
# Supply the SAME dedicated >=32-byte ACCOUNT_LINKING_SECRET in the bot and web process.
# It must differ from WEB_API_AUTH_SECRET; never commit its real value.
# ACCOUNT_LINKING_SECRET=<inject from your secret store>
# Existing WEB_API_DATABASE must reference the same agreed DB as database.DATABASE_PATH.
# No automatic migration or database copying is performed.
